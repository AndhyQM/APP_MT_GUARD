<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/authRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash"
    android:fitsSystemWindows="true"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- Contenido superior desplazable -->
    <ScrollView
        android:id="@+id/authScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/keypadContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="30dp"
            android:paddingTop="32dp"
            android:paddingEnd="30dp"
            android:paddingBottom="24dp">

            <!-- Bienvenida -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Bienvenido a"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />

            <!-- Nombre -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:text="MT GUARD"
                android:textColor="@color/text_primary"
                android:textSize="30sp"
                android:textStyle="bold" />

            <!-- Título dinámico -->
            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Confirma tu identidad para continuar"
                android:textAlignment="center"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- Huella -->
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/fingerprintView"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/fingerprint_circle_clean"
                android:clickable="true"
                android:contentDescription="Acceso biométrico"
                android:focusable="true"
                android:padding="24dp"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/huella_mt_guard"
                app:tint="@color/accent_light"
                app:tintMode="src_in" />

            <!-- Botón biométrico -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBiometria"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/button_primary"
                android:elevation="0dp"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Acceder con huella"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <!-- Separador -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/divider" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:text="o usa tu PIN"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/divider" />

            </LinearLayout>

            <!-- PIN principal -->
            <EditText
                android:id="@+id/etPin"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/input_bg"
                android:cursorVisible="true"
                android:digits="0123456789"
                android:gravity="center"
                android:hint="PIN de 4 dígitos"
                android:importantForAutofill="no"
                android:inputType="numberPassword"
                android:maxLength="4"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:selectAllOnFocus="false"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="22sp" />

            <!-- Confirmación de PIN -->
            <EditText
                android:id="@+id/etPinConfirm"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/input_bg"
                android:cursorVisible="true"
                android:digits="0123456789"
                android:gravity="center"
                android:hint="Confirmar PIN"
                android:importantForAutofill="no"
                android:inputType="numberPassword"
                android:maxLength="4"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:selectAllOnFocus="false"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="22sp"
                android:visibility="gone" />

            <!-- Pregunta secreta -->
            <EditText
                android:id="@+id/etPregunta"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/input_bg"
                android:gravity="center_vertical"
                android:hint="Pregunta secreta"
                android:imeOptions="actionNext"
                android:inputType="textCapSentences"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Respuesta secreta -->
            <EditText
                android:id="@+id/etRespuesta"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/input_bg"
                android:gravity="center_vertical"
                android:hint="Respuesta secreta"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Acción -->
            <Button
                android:id="@+id/btnAccion"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/button_secondary"
                android:text="ENTRAR CON PIN"
                android:textColor="@color/accent_light"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Recuperar PIN -->
            <TextView
                android:id="@+id/tvOlvide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:text="¿Olvidaste tu PIN?"
                android:textColor="@color/accent_light"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Mensaje -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Acceso protegido y cifrado"
                android:textColor="@color/status_ok"
                android:textSize="12sp" />

        </LinearLayout>

    </ScrollView>

    <!-- Teclado numérico fijo -->
    <LinearLayout
        android:id="@+id/keypadContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/keypad_panel_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="7dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- 1, 2, 3 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/key1"
                android:layout_width="76dp"
                android:layout_height="44dp"
                android:layout_margin="3dp"
                android:background="@drawable/keypad_key_bg"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="1"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/key2"
                android:layout_width="76dp"
                android:layout_height="44dp"
                android:layout_margin="3dp"
                android:background="@drawable/keypad_key_bg"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="2"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/key3"
                android:layout_width="76dp"
                android:layout_height="44dp"
                android:layout_margin="3dp"
                android:background="@drawable/keypad_key_bg"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="3"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

        </LinearLayout>

        <!-- 4, 5, 6 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/key4"
                android:layout_width="76dp"
                android:layout_height="44dp"
                android:layout_margin="3dp"
                android:background="@drawable/keypad_key_bg"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="4"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/key5"
                android:layout_width="76dp"
                android:layout_height="44dp"
                android:layout_margin="3dp"
                android:background="@drawable/keypad_key_bg"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="5"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/key6"
                android:layout_width="76dp"
                android:layout_height="44dp"
                android:layout_margin="3dp"
                android:background="@drawable/keypad_key_bg"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="6"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

        </LinearLayout>

        <!-- 7, 8, 9 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/key7"
                android:layout_width="76dp"
                android:layout_height="44dp"
                android:layout_margin="3dp"
                android:background="@drawable/keypad_key_bg"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="7"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/key8"
                android:layout_width="76dp"
                android:layout_height="44dp"
                android:layout_margin="3dp"
                android:background="@drawable/keypad_key_bg"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="8"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/key9"
                android:layout_width="76dp"
                android:layout_height="44dp"
                android:layout_margin="3dp"
                android:background="@drawable/keypad_key_bg"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="9"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

        </LinearLayout>

        <!-- Limpiar, 0 y borrar -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/keyClear"
                android:layout_width="76dp"
                android:layout_height="44dp"
                android:layout_margin="3dp"
                android:background="@drawable/keypad_key_bg"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="C"
                android:textColor="@color/status_danger"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/key0"
                android:layout_width="76dp"
                android:layout_height="44dp"
                android:layout_margin="3dp"
                android:background="@drawable/keypad_key_bg"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="0"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/keyBackspace"
                android:layout_width="76dp"
                android:layout_height="44dp"
                android:layout_margin="3dp"
                android:background="@drawable/keypad_key_bg"
                android:contentDescription="Borrar último número"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="⌫"
                android:textColor="@color/accent_light"
                android:textSize="20sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>